{
  "name": "fabian-steiner-resume",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Personal website and online resume of Ing. Fabian Steiner BSc.",
  "homepage": "https://fabian.stei-ner.net",
  "license": "MIT",
  "author": "Fabian Steiner",
  "repository": {
    "type": "git",
    "url": "https://github.com/fasteiner/website.git"
  },
  "scripts": {
    "dev": "vite",
    "dev-docker": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:pdf": "node scripts/build-pdf.mjs",
    "preview": "vite preview",
    "test": "npm run build && npm run build:pdf && npm run test:e2e",
    "test:e2e": "playwright test",
    "images": "node scripts/generate-images.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/mulish": "^5.3.0",
    "@fontsource/saira-extra-condensed": "^5.3.0",
    "bootstrap": "^5.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.17.0",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@playwright/test": "1.63.0",
    "@types/bootstrap": "^5.2.10",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "sass": "^1.83.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^8.0.0"
  }
}
